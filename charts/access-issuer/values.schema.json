{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "access-issuer",
  "type": "object",
  "additionalProperties": false,
  "_comment": "Nothing is required here that the template already refuses to render without. The schema catches typos and wrong types; `required` in the template catches an unset value, with a sentence saying why it matters. Duplicating it would only mean the shipped values.yaml — which is deliberately empty — fails its own lint.",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "issuerURL": {
      "type": "string",
      "pattern": "^(https?://.*)?$"
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "signingKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string",
              "minLength": 1
            },
            "issuerKind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "algorithm": {
              "enum": [
                "RSA",
                "ECDSA"
              ]
            },
            "size": {
              "type": "integer",
              "enum": [
                256,
                384,
                521,
                2048,
                3072,
                4096
              ]
            },
            "encoding": {
              "enum": [
                "PKCS1",
                "PKCS8"
              ]
            },
            "renewBefore": {
              "$ref": "#/definitions/duration"
            },
            "duration": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "oauthClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecret": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "clusters": {
          "type": "array",
          "description": "Clusters whose workloads may exchange, each verified against the key set that cluster publishes. No secret in any row.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "issuer"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The estate's word for the cluster; what a workload matcher names."
              },
              "issuer": {
                "type": "string",
                "description": "The `iss` its ServiceAccount tokens carry."
              },
              "jwksUri": {
                "type": "string",
                "description": "Where its public keys are. Empty discovers it from the issuer."
              }
            }
          }
        }
      }
    },
    "lifetimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/definitions/duration"
        },
        "refresh": {
          "$ref": "#/definitions/duration"
        },
        "hold": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tls": {
          "type": "boolean"
        },
        "cluster": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              }
            }
          }
        },
        "gatewayClassName": {
          "type": "string"
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string"
            },
            "issuerKind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "privateKey": {
              "$ref": "#/definitions/privateKey"
            }
          }
        },
        "sharedWith": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootRedirect": {
          "type": "string",
          "description": "Where a bare GET of the host root goes; empty serves 404."
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatewayNamespace": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "githubRoster": {
      "type": "object",
      "additionalProperties": false,
      "description": "The GitHub controller: a second process beside the service that makes each organisation's teams match the policy's github table.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render the controller. Needs exchange.clusters to name this cluster and console.mount to be set."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "interval": {
          "$ref": "#/definitions/duration",
          "description": "How long between passes."
        },
        "actsIn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9])*$"
          },
          "description": "The organisations the controller changes. Every other bound organisation is derived and reported, and left alone."
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "githubRunnerApps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,14}[a-z0-9])?$"
          }
        }
      }
    },
    "githubApps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogue": {
          "type": "array",
          "description": "GitHub Apps declared as data, created and installed from the console. The service validates the whole catalogue again at start.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "org",
              "permissions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
              },
              "org": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9])*$"
              },
              "name": {
                "type": "string",
                "maxLength": 34
              },
              "description": {
                "type": "string"
              },
              "public": {
                "type": "boolean"
              },
              "permissions": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "admin"
                  ]
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "installation": {
                "type": "string",
                "enum": [
                  "all",
                  "selected"
                ]
              },
              "grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "group",
                    "repositories",
                    "permissions"
                  ],
                  "properties": {
                    "group": {
                      "type": "string",
                      "minLength": 1
                    },
                    "repositories": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "permissions": {
                      "type": "object",
                      "minProperties": 1,
                      "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "read",
                          "write",
                          "admin"
                        ]
                      }
                    }
                  }
                }
              },
              "push": {
                "type": "object",
                "additionalProperties": false,
                "description": "Copy this App's credential to a secret store with an External Secrets PushSecret: its three property keys only, to the store and path named here. Absent pushes nothing.",
                "required": [
                  "secretStore",
                  "remoteKey"
                ],
                "properties": {
                  "secretStore": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "SecretStore",
                          "ClusterSecretStore"
                        ]
                      }
                    }
                  },
                  "remoteKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "refreshInterval": {
                    "$ref": "#/definitions/duration"
                  },
                  "deletionPolicy": {
                    "type": "string",
                    "enum": [
                      "None",
                      "Delete"
                    ]
                  }
                }
              }
            }
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "description": "Copy the link App and one App per bound organisation to a secret store with an External Secrets PushSecret, for recovery: the whole Secret bundled under one remote key, because the key names inside it are not stable. Absent pushes nothing. deletionPolicy is deliberately not settable -- the case this exists for is the Secret going away.",
          "required": [
            "secretStore",
            "remoteKey"
          ],
          "properties": {
            "secretStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "SecretStore",
                    "ClusterSecretStore"
                  ]
                }
              }
            },
            "remoteKey": {
              "type": "string",
              "minLength": 1
            },
            "refreshInterval": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "secretManagers": {
      "type": "array",
      "description": "The secret stores the console SHOWS. Read-only: nothing here writes to a store, and the reader is granted the declared state (policies, identity groups, aliases, auth mounts) and never a secret's value. Empty declares none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address",
          "namespaces"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "address": {
            "type": "string",
            "description": "The store's API. No path: the API path is appended to it.",
            "pattern": "^https?://[^/?#]+$"
          },
          "mount": {
            "type": "string",
            "minLength": 1,
            "description": "The JWT auth mount to log in on. Default jwt-roster."
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "The role on that mount. Default roster."
          },
          "audience": {
            "type": "string",
            "minLength": 1,
            "description": "The exchange audience the reader asks the issuer for. Default openbao."
          },
          "caCertSecret": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "description": "A Secret holding a PEM bundle, trusted IN ADDITION to the system's roots for this store alone.",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "description": "Default ca.crt."
              }
            }
          },
          "caCertConfigMap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "description": "A ConfigMap holding a PEM bundle, trusted IN ADDITION to the system's roots for this store alone. What trust-manager writes into every namespace; name this OR caCertSecret, never both.",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "description": "Default ca.crt."
              }
            }
          },
          "namespaces": {
            "type": "array",
            "minItems": 1,
            "description": "The namespaces to draw. A namespace IS an environment: the model is one level deep, so a name with a slash is refused.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
                },
                "environment": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
                  "description": "The roster environment this namespace mirrors. Defaults to the name."
                }
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "description": "The audit installation (github.com/truvity/audit) this service connects to as a plugin. Empty keeps nothing beyond log lines, and shows no Audit page.",
      "properties": {
        "writer": {
          "type": "string",
          "pattern": "^(https?://.+)?$",
          "description": "The audit installation's receiver: one address, which takes the records and answers RegisterCatalogue on the same port. Empty keeps no trail beyond the log."
        },
        "query": {
          "type": "string",
          "pattern": "^(https?://.+)?$",
          "description": "The installation's query service, for the console's Audit page. Empty shows no page."
        },
        "audience": {
          "type": "string",
          "description": "The policy client whose audience the Audit page's tokens carry, and which the query service trusts."
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string",
              "minLength": 1,
              "description": "The audience of the projected token presented to the writer and registry."
            },
            "expirationSeconds": {
              "type": "integer",
              "minimum": 600
            }
          }
        },
        "forwardedForTrustedHops": {
          "type": "integer",
          "minimum": 0,
          "description": "How many of the deployment's own proxies append to X-Forwarded-For in front of the service; the client is the entry just left of them. 0 records the peer."
        }
      }
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "description": "GitHub Actions as a source of CI identity.",
      "properties": {
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GitHub organisations whose workflows may exchange a token. Empty verifies no CI token at all."
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "description": "The console allowed to call SessionService from a browser.",
      "properties": {
        "origin": {
          "type": "string",
          "description": "One origin, e.g. https://dir.example. Empty serves SessionService not at all."
        },
        "mount": {
          "type": "string",
          "description": "Where the console is mounted on this issuer's origin, e.g. /console. Empty serves no console."
        },
        "client": {
          "type": "string",
          "description": "The declared client id the console signs people in as. Empty keeps the console's own sign-in page."
        }
      }
    },
    "cluster": {
      "type": "string",
      "description": "What this cluster is called; becomes part of a ServiceAccount's subject. Empty keeps the unqualified form."
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "description": "The corporate directories this service reads itself.",
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "kubernetes",
            "memory"
          ],
          "description": "Where what an operator connected is kept. `memory` makes a restart a fresh installation."
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refreshInterval": {
              "type": "string"
            },
            "freshnessWindow": {
              "type": "string"
            },
            "probeInterval": {
              "type": "string"
            }
          }
        },
        "sessionLifetime": {
          "type": "string"
        },
        "login": {
          "type": "boolean",
          "description": "Whether the console offers a sign-in of its own under /console/login."
        },
        "workspaces": {
          "type": "array",
          "description": "Declared workspaces: each names a Secret holding a service-account key and the admin to impersonate.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "admin",
              "secretName"
            ],
            "properties": {
              "backend": {
                "type": "string"
              },
              "admin": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              },
              "secretKey": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "serve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "syncGroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "description": "Copy the credential of every connected workspace to a secret store with an External Secrets PushSecret, for recovery: the whole Secret bundled under one remote key, because the key names inside it are not stable. Absent pushes nothing. deletionPolicy is deliberately not settable -- the case this exists for is the Secret going away.",
          "required": [
            "secretStore",
            "remoteKey"
          ],
          "properties": {
            "secretStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "SecretStore",
                    "ClusterSecretStore"
                  ]
                }
              }
            },
            "remoteKey": {
              "type": "string",
              "minLength": 1
            },
            "refreshInterval": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metrics pushed over OTLP by the service and the GitHub controller. Empty publishes nothing.",
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "description": "The collector's OTLP/HTTP endpoint; empty publishes nothing."
        }
      }
    }
  },
  "definitions": {
    "privateKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "RSA",
            "ECDSA"
          ]
        },
        "size": {
          "type": "integer",
          "enum": [
            256,
            384,
            521,
            2048,
            3072,
            4096
          ]
        },
        "encoding": {
          "enum": [
            "PKCS1",
            "PKCS8"
          ]
        },
        "rotationPolicy": {
          "enum": [
            "Never",
            "Always"
          ]
        }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
    }
  }
}
