{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "access-issuer",
  "type": "object",
  "additionalProperties": false,
  "_comment": "Nothing is required here that the template already refuses to render without. The schema catches typos and wrong types; `required` in the template catches an unset value, with a sentence saying why it matters. Duplicating it would only mean the shipped values.yaml \u2014 which is deliberately empty \u2014 fails its own lint.",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "issuerURL": {
      "type": "string",
      "pattern": "^(https?://.*)?$"
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "signingKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string",
              "minLength": 1
            },
            "issuerKind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "size": {
              "type": "integer",
              "enum": [
                2048,
                3072,
                4096
              ]
            },
            "renewBefore": {
              "$ref": "#/definitions/duration"
            },
            "duration": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "oauthClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecret": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workloadTokens": {
          "type": "boolean"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "lifetimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/definitions/duration"
        },
        "refresh": {
          "$ref": "#/definitions/duration"
        },
        "hold": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tls": {
          "type": "boolean"
        },
        "cluster": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "gatewayClassName": {
          "type": "string"
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string"
            },
            "issuerKind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatewayNamespace": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "description": "GitHub Actions as a source of CI identity.",
      "properties": {
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GitHub organisations whose workflows may exchange a token. Empty verifies no CI token at all."
        }
      }
    }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|\u00b5s|ms|s|m|h)([0-9]+(ns|us|\u00b5s|ms|s|m|h))*$"
    }
  }
}
