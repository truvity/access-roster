{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "access-issuer",
  "type": "object",
  "additionalProperties": false,
  "_comment": "Nothing is required here that the template already refuses to render without. The schema catches typos and wrong types; `required` in the template catches an unset value, with a sentence saying why it matters. Duplicating it would only mean the shipped values.yaml \u2014 which is deliberately empty \u2014 fails its own lint.",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "issuerURL": {
      "type": "string",
      "pattern": "^(https?://.*)?$"
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "signingKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string",
              "minLength": 1
            },
            "issuerKind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "size": {
              "type": "integer",
              "enum": [
                2048,
                3072,
                4096
              ]
            },
            "renewBefore": {
              "$ref": "#/definitions/duration"
            },
            "duration": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "oauthClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecret": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "clusters": {
          "type": "array",
          "description": "Clusters whose workloads may exchange, each verified against the key set that cluster publishes. No secret in any row.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "issuer"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The estate's word for the cluster; what a workload matcher names."
              },
              "issuer": {
                "type": "string",
                "description": "The `iss` its ServiceAccount tokens carry."
              },
              "jwksUri": {
                "type": "string",
                "description": "Where its public keys are. Empty discovers it from the issuer."
              }
            }
          }
        }
      }
    },
    "lifetimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/definitions/duration"
        },
        "refresh": {
          "$ref": "#/definitions/duration"
        },
        "hold": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tls": {
          "type": "boolean"
        },
        "cluster": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "gatewayClassName": {
          "type": "string"
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string"
            },
            "issuerKind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            }
          }
        },
        "sharedWith": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootRedirect": {
          "type": "string",
          "description": "Where a bare GET of the host root goes; empty serves 404."
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatewayNamespace": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "description": "GitHub Actions as a source of CI identity.",
      "properties": {
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GitHub organisations whose workflows may exchange a token. Empty verifies no CI token at all."
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "description": "The console allowed to call SessionService from a browser.",
      "properties": {
        "origin": {
          "type": "string",
          "description": "One origin, e.g. https://dir.example. Empty serves SessionService not at all."
        },
        "mount": {
          "type": "string",
          "description": "Where the console is mounted on this issuer's origin, e.g. /console. Empty serves no console."
        }
      }
    },
    "cluster": {
      "type": "string",
      "description": "What this cluster is called; becomes part of a ServiceAccount's subject. Empty keeps the unqualified form."
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "description": "The corporate directories this service reads itself.",
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "kubernetes",
            "memory"
          ],
          "description": "Where what an operator connected is kept. `memory` makes a restart a fresh installation."
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refreshInterval": {
              "type": "string"
            },
            "freshnessWindow": {
              "type": "string"
            },
            "probeInterval": {
              "type": "string"
            }
          }
        },
        "sessionLifetime": {
          "type": "string"
        },
        "login": {
          "type": "boolean",
          "description": "Whether the console offers a sign-in of its own under /console/login."
        },
        "workspaces": {
          "type": "array",
          "description": "Declared workspaces: each names a Secret holding a service-account key and the admin to impersonate.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "admin",
              "secretName"
            ],
            "properties": {
              "backend": {
                "type": "string"
              },
              "admin": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              },
              "secretKey": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "serve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "syncGroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|\u00b5s|ms|s|m|h)([0-9]+(ns|us|\u00b5s|ms|s|m|h))*$"
    }
  }
}
