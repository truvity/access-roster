{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "directory-roster chart values",
  "description": "Strict at the top level: unknown keys are rejected so a typo fails the render instead of being silently ignored. Kubernetes passthrough fields stay open.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "$ref": "#/definitions/listener" },
        "console": { "$ref": "#/definitions/listener" },
        "health": { "$ref": "#/definitions/listener" }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string" },
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "tls": { "type": "boolean" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refreshInterval": { "$ref": "#/definitions/duration" },
        "freshnessWindow": { "$ref": "#/definitions/duration" },
        "probeInterval": { "$ref": "#/definitions/duration" }
      }
    },
    "oauthClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "backend", "admin", "secretName"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "backend": { "enum": ["google"] },
          "admin": { "type": "string", "minLength": 3 },
          "secretName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "serviceAccount"],
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "serviceAccount": { "type": "string", "minLength": 1 }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "login": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directory": { "type": "boolean" },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": { "type": "string" },
                "clientSecretName": { "type": "string" }
              }
            },
            "forwardedBearer": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "issuer": { "type": "string" } }
            }
          }
        },
        "holdWindow": { "$ref": "#/definitions/duration" }
      }
    },
    "policy": {
      "type": "object",
      "description": "The declared layer of the policy; see docs/reference/policy.md. Validated by the hub at start, not here, because its shape is the policy schema rather than chart values."
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiClients": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "gatewayNamespace": { "type": "string" }
      }
    },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "duration": { "type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$" }
  }
}
