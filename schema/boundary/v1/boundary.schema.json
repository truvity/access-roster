{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sluis.id/schema/boundary/v1/boundary.schema.json",
  "title": "The payload of a signed Boundary document",
  "type": "object",
  "properties": {
    "default": {
      "$ref": "#/$defs/Boundary"
    }
  },
  "required": [
    "default"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Boundary": {
      "type": "object",
      "description": "Boundary is the kind Boundary (bootstrap file and signed config); id \"default\".",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "production"
          ],
          "description": "\"development\", \"staging\" or \"production\""
        },
        "issuer": {
          "type": "string",
          "pattern": "^https?://.",
          "description": "the issuer URL of the boundary: http or https"
        },
        "uid_block": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "declared_kinds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_tenant": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^$|^[a-z0-9._-]{1,128}$",
          "description": "decision D-4: the one tenant of the skeleton until Tenant items exist; empty, or a store part"
        },
        "acr_values_supported": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[!#-\\[\\]-~]{1,256}$"
          },
          "description": "The acr values this boundary enforces in acr_values and lists in discovery: the one list both read; a requested value that is not here is ignored. Each is visible ASCII without a quote, a backslash or a space (a request separates values by spaces), 1 to 256 bytes, and may begin with - or _; at most 16, none twice. A value that YAML would read as a number is written in quotes: \"1\"."
        }
      },
      "required": [
        "name",
        "kind",
        "level",
        "environment",
        "issuer"
      ],
      "unevaluatedProperties": false
    }
  }
}
