{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sluis.id/schema/upstream/v1/upstream.schema.json",
  "title": "The payload of a signed Upstream document",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z0-9._-]{1,128}$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/Upstream"
  },
  "$defs": {
    "Upstream": {
      "type": "object",
      "description": "Upstream is the kind Upstream; id is the upstream's name. It names no tenant (kinds.yaml).",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "oidc"
          ],
          "description": "the kind of upstream: \"oidc\""
        },
        "issuer": {
          "type": "string",
          "pattern": "^https?://.",
          "description": "the upstream's issuer URL: http or https"
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_claim": {
          "type": "string",
          "minLength": 1
        },
        "org_claim": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "secret": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "the name of sluis's client secret at the upstream in the secret source (0005 \"Secret sources\")"
        }
      },
      "required": [
        "kind",
        "issuer",
        "client_id",
        "subject_claim"
      ],
      "unevaluatedProperties": false
    }
  }
}
