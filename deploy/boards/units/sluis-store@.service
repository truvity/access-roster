# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis store (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
Requires=sluis-drv-store-rqlite-durable@%i.service sluis-drv-store-rqlite-temp@%i.service sluis-drv-store-file@%i.service sluis-drv-store-credential@%i.service
After=sluis-drv-store-rqlite-durable@%i.service sluis-drv-store-rqlite-temp@%i.service sluis-drv-store-file@%i.service sluis-drv-store-credential@%i.service

[Service]
Type=simple
User=sluis-store-%i
Group=sluis-store-%i
SupplementaryGroups=sluis-drv-store-credential-%i sluis-drv-store-file-%i sluis-drv-store-rqlite-%i sluis-drv-writer-spool-%i sluis-key-%i
ExecStart=/opt/sluis/bin/actors/store serve --boundary %i --socket /run/sluis/store/%i.sock --bootstrap /etc/sluis/bootstrap.d/%i.yaml
Restart=on-failure
RestartSec=2s

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sluis/store

[Install]
WantedBy=multi-user.target
