# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis key (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
Requires=sluis-drv-key-software@%i.service
After=sluis-drv-key-software@%i.service
StartLimitIntervalSec=120
StartLimitBurst=40

[Service]
Type=simple
User=sluis-key-%i
Group=sluis-key-%i
SupplementaryGroups=sluis-drv-key-software-%i sluis-drv-writer-spool-%i sluis-store-%i
ExecStart=/opt/sluis/bin/actors/key serve --boundary %i --run-dir /run/sluis/key/%i --store-socket /run/sluis/store/%i.sock --driver-socket /run/sluis/key/%i/driver/key-store.sock --transport-socket /run/sluis/audit/%i/emit.sock --node %H
Restart=on-failure
RestartSec=2s
Environment=GOMEMLIMIT=24MiB

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sluis/key

[Install]
WantedBy=multi-user.target
