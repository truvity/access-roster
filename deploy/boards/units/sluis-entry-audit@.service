# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis entry audit front (%i)
Documentation=https://sluis.id/runtimes/bare-metal/

[Service]
Type=simple
User=sluis-entry-%i
Group=sluis-entry-%i
SupplementaryGroups=sluis-drv-writer-spool-%i sluis-harness-forwarder-%i sluis-reader-%i
ExecStart=/opt/sluis/bin/actors/entry serve --boundary %i --front audit --socket /run/sluis/entry/%i-audit.sock --socket-gid 61027
Restart=on-failure
RestartSec=2s

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/sluis/entry

[Install]
WantedBy=multi-user.target
