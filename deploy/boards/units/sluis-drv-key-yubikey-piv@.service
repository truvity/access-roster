# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver key-yubikey-piv (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
Requires=pcscd.socket
After=pcscd.socket

[Service]
Type=simple
User=sluis-drv-key-yubikey-piv-%i
Group=sluis-drv-key-yubikey-piv-%i
SupplementaryGroups=sluis-key-drv-%i sluis-pcsc-%i
StateDirectory=sluis-state/%i/drv-key-yubikey-piv
StateDirectoryMode=0700
RuntimeDirectory=sluis-drv-key-yubikey-piv-%i
RuntimeDirectoryMode=0700
ExecStart=/opt/sluis/bin/drivers/key/yubikey-piv serve --boundary %i --socket /run/sluis/key/%i/driver/key-store.sock --environment development --node %H --admin-socket /run/sluis-drv-key-yubikey-piv-%i/admin.sock --bootstrap /etc/sluis/bootstrap.d/%i.yaml --state-dir /var/lib/sluis-state/%i/drv-key-yubikey-piv --serial ${SLUIS_CARD_SERIAL} --socket-gid 61030
Restart=on-failure
RestartSec=2s
Environment=GOMEMLIMIT=24MiB
EnvironmentFile=/etc/sluis/yubikey-piv-%i.env

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
ReadWritePaths=/run/sluis/key/%i/driver

[Install]
WantedBy=multi-user.target
