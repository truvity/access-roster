# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis adapter-slack (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
StartLimitIntervalSec=0

[Service]
Type=simple
User=sluis-adapter-slack-%i
Group=sluis-adapter-slack-%i
SupplementaryGroups=sluis-drv-writer-spool-%i sluis-key-%i sluis-policy-%i sluis-store-%i sluis-keyc-011-%i
ExecStart=/usr/libexec/sluis/actors/adapter-slack serve --boundary %i --socket /run/sluis/adapter-slack/%i.sock
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30
Environment=GOMEMLIMIT=24MiB

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
NoExecPaths=-/usr/libexec/sluis/drivers -/run/sluis/adapter-slack -/tmp -/var/tmp -/dev/shm
ReadWritePaths=/run/sluis/adapter-slack

[Install]
WantedBy=multi-user.target
