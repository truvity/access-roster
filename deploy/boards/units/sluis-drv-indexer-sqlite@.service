# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver indexer-sqlite (%i)
Documentation=https://sluis.id/runtimes/bare-metal/

[Service]
Type=simple
User=sluis-drv-indexer-sqlite-%i
Group=sluis-drv-indexer-sqlite-%i
SupplementaryGroups=sluis-indexer-drv-%i sluis-reader-%i
StateDirectory=sluis-state/%i/drv-indexer-sqlite
StateDirectoryMode=0700
ExecStart=/opt/sluis/bin/drivers/indexer/sqlite serve --boundary %i --socket /run/sluis/indexer/%i/index.sock --state-dir /var/lib/sluis-state/%i/drv-indexer-sqlite --ro-socket /run/sluis/indexer/%i/index-ro.sock --ro-socket-gid 61018 --socket-gid 61026
Restart=on-failure
RestartSec=2s

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/sluis/indexer/%i

[Install]
WantedBy=multi-user.target
