// Generated by tools/gen/units. Installed by `just boards-deploy` with SLUIS_BOARDS_KEY_DRIVER=yubikey-piv,
// and only on a board whose pcscd is built with polkit (it ships org.debian.pcsc-lite.policy).
// Only the card driver's user reaches the card service and the cards (ADR 0006, "Exclusive card access").
polkit.addRule(function(action, subject) {
    if (action.id == "org.debian.pcsc-lite.access_pcsc" || action.id == "org.debian.pcsc-lite.access_card") {
        return subject.user == "sluis-drv-key-yubikey-piv-dev" ? polkit.Result.YES : polkit.Result.NO;
    }
});
