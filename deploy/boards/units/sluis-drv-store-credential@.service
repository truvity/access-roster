# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver store-credential (%i)
Documentation=https://sluis.id/runtimes/bare-metal/

[Service]
Type=simple
User=sluis-drv-store-credential-%i
Group=sluis-drv-store-credential-%i
SupplementaryGroups=sluis-store-drv-%i
ExecStart=/opt/sluis/bin/drivers/store/credential serve --boundary %i --socket /run/sluis/store/%i/secret-source.sock --socket-gid 61022
Restart=on-failure
RestartSec=2s
LoadCredential=client-dev:/etc/sluis/credentials/%i/sluis-drv-store-credential/client-dev
LoadCredential=client-example-app:/etc/sluis/credentials/%i/sluis-drv-store-credential/client-example-app
LoadCredential=upstream-workforce:/etc/sluis/credentials/%i/sluis-drv-store-credential/upstream-workforce

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/sluis/store/%i

[Install]
WantedBy=multi-user.target
