# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver store-credential (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
StartLimitIntervalSec=0

[Service]
Type=simple
User=sluis-drv-store-credential-%i
Group=sluis-drv-store-credential-%i
SupplementaryGroups=sluis-store-drv-%i
ExecStart=/usr/libexec/sluis/drivers/store/credential serve --boundary %i --socket /run/sluis/store/%i/secret-source.sock --socket-gid ${SLUIS_UID_DRIVER_STORE_CREDENTIAL}
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30
EnvironmentFile=/etc/sluis/uids-%i.env
LoadCredentialEncrypted=client-dev:/etc/sluis/credentials/%i/sluis-drv-store-credential/client-dev
LoadCredentialEncrypted=client-example-app:/etc/sluis/credentials/%i/sluis-drv-store-credential/client-example-app
LoadCredentialEncrypted=upstream-workforce:/etc/sluis/credentials/%i/sluis-drv-store-credential/upstream-workforce

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
ReadWritePaths=/run/sluis/store/%i
