# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis console (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
StartLimitIntervalSec=0

[Service]
Type=simple
User=sluis-console-%i
Group=sluis-console-%i
SupplementaryGroups=sluis-adapter-github-%i sluis-adapter-slack-%i sluis-adapter-upstream-oidc-%i sluis-drv-writer-spool-%i sluis-exchange-%i sluis-key-%i sluis-policy-%i sluis-quota-%i sluis-reader-%i sluis-session-%i sluis-store-%i sluis-keyc-002-%i
ExecStart=/usr/libexec/sluis/actors/console serve --boundary %i --socket /run/sluis/console/%i.sock
Restart=on-failure
RestartSec=2s
Environment=SLUIS_RESTART_FILE=/run/sluis/console/restarts-sluis-console-%i

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
NoExecPaths=-/usr/libexec/sluis/drivers -/run/sluis/console -/tmp -/var/tmp -/dev/shm
ReadWritePaths=/run/sluis/console

[Install]
WantedBy=multi-user.target
