# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver writer-fs (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
StartLimitIntervalSec=0

[Service]
Type=simple
User=sluis-drv-writer-fs-%i
Group=sluis-drv-writer-fs-%i
SupplementaryGroups=sluis-writer-drv-%i
StateDirectory=sluis-state/%i/drv-writer-fs
StateDirectoryMode=0750
ExecStart=/usr/libexec/sluis/drivers/writer/fs serve --boundary %i --socket /run/sluis/writer/%i/blob.sock --root /var/lib/sluis-state/%i/drv-writer-fs --socket-gid ${SLUIS_UID_DRIVER_WRITER_FS}
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30
EnvironmentFile=/etc/sluis/uids-%i.env

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
ReadWritePaths=/run/sluis/writer/%i
