# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis policy (%i)
Documentation=https://sluis.id/runtimes/bare-metal/

[Service]
Type=simple
User=sluis-policy-%i
Group=sluis-policy-%i
SupplementaryGroups=sluis-key-%i sluis-store-%i
ExecStart=/opt/sluis/bin/actors/policy serve --boundary %i --socket /run/sluis/policy/%i.sock
Restart=on-failure
RestartSec=2s

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/sluis/policy

[Install]
WantedBy=multi-user.target
