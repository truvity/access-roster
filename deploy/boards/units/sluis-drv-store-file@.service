# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver store-file (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
StartLimitIntervalSec=0

[Service]
Type=simple
User=sluis-drv-store-file-%i
Group=sluis-drv-store-file-%i
SupplementaryGroups=sluis-store-drv-%i
ExecStart=/usr/libexec/sluis/drivers/store/file serve --boundary %i --socket /run/sluis/store/%i/config-source.sock --dir /etc/sluis/config/%i --socket-gid ${SLUIS_UID_DRIVER_STORE_FILE}
Restart=on-failure
RestartSec=2s
Environment=SLUIS_RESTART_FILE=/run/sluis/store/%i/restarts-sluis-drv-store-file-%i
EnvironmentFile=/etc/sluis/uids-%i.env

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
ReadWritePaths=/run/sluis/store/%i
