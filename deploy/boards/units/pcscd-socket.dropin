# Generated by tools/gen/units. Installed by `just boards-deploy` with SLUIS_BOARDS_KEY_DRIVER=yubikey-piv.
# The card service takes connections from the card driver's group and from root, and from nobody else.
# The stock socket is mode 0666 and the Ubuntu 22.04 build of pcscd has no polkit, so this is the control there.
[Socket]
SocketMode=0660
SocketUser=root
SocketGroup=sluis-drv-key-yubikey-piv-dev
