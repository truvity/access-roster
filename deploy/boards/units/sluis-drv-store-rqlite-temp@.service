# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver store-rqlite temp (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
After=sluis-rqlite.service

[Service]
Type=simple
User=sluis-drv-store-rqlite-%i
Group=sluis-drv-store-rqlite-%i
SupplementaryGroups=sluis-store-drv-%i
ExecStart=/opt/sluis/bin/drivers/store/rqlite serve --boundary %i --socket /run/sluis/store/%i/temp.sock --rqlite-url ${SLUIS_RQLITE_URL} --namespace temp
Restart=on-failure
RestartSec=2s
Environment=SLUIS_RQLITE_URL=http://127.0.0.1:4001
EnvironmentFile=-/etc/sluis/rqlite-%i.env

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sluis/store/%i

[Install]
WantedBy=multi-user.target
