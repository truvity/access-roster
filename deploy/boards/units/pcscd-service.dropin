# Generated by tools/gen/units. Installed by `just boards-deploy` with SLUIS_BOARDS_KEY_DRIVER=yubikey-piv.
# systemd gives the socket in RuntimeDirectory=pcscd to the user pcscd runs as (Ubuntu 26.04): give it back to the card driver's group.
[Service]
ExecStartPre=-+/usr/bin/chown root:sluis-pcsc-dev /run/pcscd/pcscd.comm
