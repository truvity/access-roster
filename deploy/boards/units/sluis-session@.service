# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis session (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
StartLimitIntervalSec=120
StartLimitBurst=40

[Service]
Type=simple
User=sluis-session-%i
Group=sluis-session-%i
SupplementaryGroups=sluis-adapter-upstream-oidc-%i sluis-drv-writer-spool-%i sluis-exchange-%i sluis-key-%i sluis-policy-%i sluis-signer-%i sluis-store-%i
ExecStart=/opt/sluis/bin/actors/session serve --boundary %i --socket /run/sluis/session/%i.sock
Restart=on-failure
RestartSec=2s
Environment=GOMEMLIMIT=24MiB

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sluis/session

[Install]
WantedBy=multi-user.target
