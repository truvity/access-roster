# The SHA-256 of the Go release tarballs that deploy/boards/native-build.sh installs: one line for each release of go.mod's
# `toolchain` line and each architecture, as go.dev/dl lists them (checked 2026-11-12). A bump of the toolchain adds its two
# lines here in the same change (Renovate has no manager for this file in this repository, so a bump is manual); the build fails without them, and the lines are reviewed with the bump.
#   curl -fsSL 'https://go.dev/dl/?mode=json&include=all' | jq -r '.[] | select(.version=="go1.27.4") | .files[] | select(.os=="linux" and (.arch=="amd64" or .arch=="arm64") and .kind=="archive") | "\(.filename) \(.sha256)"'
