#!/bin/sh
# Runs as ExecStartPost= of a driver unit, as the driver's own user. The kits make a driver's socket 0600, so
# the owner of the driver, another uid, could not connect. This opens it to the socket's group (the driver's own),
# which only the owner joins. The driver still answers the owner's uid alone (the OwnerOnly check of the kit).
#
#   sluis-socket-open SOCKET
set -eu
[ "$#" -eq 1 ] || { echo "usage: sluis-socket-open SOCKET" >&2; exit 2; }
n=0
while [ ! -S "$1" ]; do
	n=$((n + 1))
	[ "$n" -le 100 ] || { echo "sluis-socket-open: no socket at $1 after 10 s" >&2; exit 1; }
	sleep 0.1
done
chmod 0660 "$1"
