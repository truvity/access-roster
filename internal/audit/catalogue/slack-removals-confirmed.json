{
  "$id": "https://schemas.example/access-roster/v1/slack-removals-confirmed.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fingerprint": {
      "type": "string",
      "description": "The fingerprint of the removals the operator confirmed.",
      "x-audit-class": "shared",
      "x-audit-pii": "none"
    },
    "scope": {
      "type": "string",
      "description": "What the confirmation covers.",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "x-audit-facet": true,
      "enum": [
        "workspace",
        "channel"
      ]
    },
    "affected": {
      "type": "integer",
      "description": "How many members the removals affect.",
      "x-audit-class": "shared",
      "x-audit-pii": "none"
    }
  }
}
