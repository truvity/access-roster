{
  "$id": "https://schemas.example/access-roster/v1/slack-app-installed.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "The id the deployment catalogues the App under.",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "x-audit-facet": true
    },
    "app": {
      "type": "string",
      "description": "The Slack App's id.",
      "x-audit-class": "shared",
      "x-audit-pii": "none"
    },
    "team": {
      "type": "string",
      "description": "The Slack team id the install was made into.",
      "x-audit-class": "shared",
      "x-audit-pii": "none"
    },
    "scopes": {
      "type": "string",
      "description": "The bot scopes Slack granted, comma-separated; empty for a refused install.",
      "x-audit-class": "shared",
      "x-audit-pii": "none"
    }
  }
}
