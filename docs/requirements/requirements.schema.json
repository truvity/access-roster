{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sluis.id/requirements/requirements.schema.json",
  "title": "sluis requirements catalogue file",
  "description": "Validates index.yaml and each <area>.yaml of docs/requirements/. The lint adds the rules that JSON Schema cannot express (see schema-notes.md section 5).",
  "oneOf": [
    { "$ref": "#/$defs/indexFile" },
    { "$ref": "#/$defs/areaFile" },
    { "$ref": "#/$defs/attestationsFile" }
  ],
  "$defs": {
    "areaCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,11}$" },
    "reqId": { "type": "string", "pattern": "^REQ-[A-Z][A-Z0-9]{1,11}-[0-9]{3}$" },
    "level": { "enum": ["MUST", "SHOULD", "MAY"] },
    "source": { "enum": ["v1-parity", "stakeholder-ciam", "stakeholder-integrator", "security-review", "design-decision", "standard"] },
    "status": { "enum": ["done", "planned", "partial", "open", "out-of-scope", "withdrawn"] },
    "runtime": { "enum": ["bare-metal", "serverless", "kubernetes"] },
    "depth": { "enum": ["Full", "Partial"] },
    "verificationKind": { "enum": ["conformance-suite", "test-vectors", "integration-test", "manual"] },
    "milestoneSlug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40 },
    "sentence": { "type": "string", "minLength": 12, "maxLength": 400, "pattern": "\\.$" },
    "standardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "depth"],
      "properties": {
        "id": { "type": "string", "pattern": "^(ST|NC)-[0-9]{2,3}$" },
        "section": { "type": "string", "minLength": 1, "maxLength": 80 },
        "depth": { "$ref": "#/$defs/depth" }
      }
    },
    "verificationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "$ref": "#/$defs/verificationKind" },
        "ref": { "type": "string", "minLength": 3, "maxLength": 200 },
        "suite": { "type": "string", "pattern": "^SU-[A-Z0-9-]+$", "description": "Reserved for the suite registry (suites.yaml); optional until it exists." }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area", "statement", "rationale", "level", "source", "status", "runtimes", "standards", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/reqId" },
        "area": { "$ref": "#/$defs/areaCode" },
        "split_from": { "$ref": "#/$defs/reqId", "description": "Set on every clause cut from a compound record; names the record whose id the first clause kept." },
        "statement": { "$ref": "#/$defs/sentence" },
        "rationale": { "$ref": "#/$defs/sentence" },
        "level": { "$ref": "#/$defs/level" },
        "source": { "$ref": "#/$defs/source" },
        "status": { "$ref": "#/$defs/status" },
        "runtimes": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/runtime" } }
          ]
        },
        "standards": { "type": "array", "items": { "$ref": "#/$defs/standardRef" } },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["design", "parity"] },
          "description": "parity: part of v1 parity with no single issue; design: specified with no issue yet. Issue numbers go in issues."
        },
        "milestone": { "$ref": "#/$defs/milestoneSlug", "description": "The Product milestone the record belongs to: a key of catalogue.milestones in index.yaml, which maps it to the name of an option of the board's Product milestone field. Without it the status page infers the milestone from the issues and labels the placement as inferred." },
        "issues": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 }, "description": "Numbers of the truvity/sluis issues that deliver the record. The Product milestone of these issues places the record on the status page." },
        "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.@+-]*(/[A-Za-z0-9_][A-Za-z0-9_.@+-]*)*$", "maxLength": 200 }, "description": "Optional: repository paths of the test files of the record, as an index for the reader. Each file must exist and name the record's id. What counts as evidence is the tagged test (docs/requirements/README.md), not this list." },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verificationRef" } },
        "actors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "Optional: the actors of docs/architecture/actors.yaml that implement the record. tools/checks/actors.mjs checks each name and that the record's area is one of the actor's requirement areas." },
        "gap": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Key into catalogue.gaps. Required for an open or partial record." },
        "manual_reason": { "type": "string", "minLength": 12, "maxLength": 300, "description": "Required for a MUST whose verification is manual only." },
        "superseded_by": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reqId" }, "description": "A withdrawn record needs this or moved_to." },
        "moved_to": { "type": "string", "pattern": "^https://github\\.com/truvity/ritueel/issues/[0-9]+$", "description": "A withdrawn record that moved to another product: the issue there that carries it. A withdrawn record needs this or superseded_by." }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["req", "by", "on", "checked"],
      "properties": {
        "req": { "$ref": "#/$defs/reqId" },
        "by": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$", "description": "Who checked it: the commit e-mail address of the person, as in their commits to this public repository (a noreply address where the person uses one)." },
        "on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The date of the check, UTC." },
        "checked": { "$ref": "#/$defs/sentence", "description": "What was checked, in one sentence." },
        "agent_run": { "const": true, "description": "Present, and true, when an agent ran the check and the person in by stands behind it. Absent when the person ran it. It is never false." }
      }
    },
    "attestationsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "attestations"],
      "properties": {
        "schema": { "const": 1 },
        "attestations": { "type": "array", "items": { "$ref": "#/$defs/attestation" } }
      }
    },
    "areaFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "area", "requirements"],
      "properties": {
        "schema": { "const": 1 },
        "area": { "$ref": "#/$defs/areaCode" },
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "indexFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "catalogue"],
      "properties": {
        "schema": { "const": 1 },
        "catalogue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "checked", "vocabulary", "areas", "milestones", "gaps"],
          "properties": {
            "title": { "type": "string" },
            "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "vocabulary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "source", "status", "runtimes", "verification", "depth"],
              "properties": {
                "level": { "type": "array", "items": { "$ref": "#/$defs/level" } },
                "source": { "type": "array", "items": { "$ref": "#/$defs/source" } },
                "status": { "type": "array", "items": { "$ref": "#/$defs/status" } },
                "runtimes": { "type": "array", "items": { "$ref": "#/$defs/runtime" } },
                "verification": { "type": "array", "items": { "$ref": "#/$defs/verificationKind" } },
                "depth": { "type": "array", "items": { "$ref": "#/$defs/depth" } }
              }
            },
            "areas": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/areaCode" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "file"],
                "properties": {
                  "title": { "type": "string", "minLength": 3 },
                  "file": { "type": "string", "pattern": "^[a-z0-9]+\\.yaml$" },
                  "retired": { "type": "boolean", "description": "true when every record of the area is withdrawn: the area keeps its file and ids and the site leaves it out of the area lists." }
                }
              }
            },
            "milestones": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/milestoneSlug" },
              "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 60 },
              "description": "The slug of each milestone a record may name, and the name of the board's Product milestone option it stands for."
            },
            "gaps": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
              "additionalProperties": { "type": "string", "minLength": 12 }
            }
          }
        }
      }
    }
  }
}
