---
// The first screen of the home page: the three pains side by side, so a reader sees theirs
// before anything else. Each column links to the full section below it. The third shows the
// chain in miniature. The mission follows (pages.md: the pain, then the mission, then the
// answers), then the call to action, with the honest status: v1 runs today, v2 is designed.
import Mark from './Mark.astro';
import { band, fragmented, ceremonies } from './data';

const shown = band.sso.chips.map((n) => fragmented.find((c) => c.name === n)!);
const more = fragmented.length - shown.length;
const heavy = ceremonies.filter((c) => c.band);
---

<section class="band" aria-label="The three pains">
  <div class="band-col band-sso">
    <h2><a href={band.sso.target}>{band.sso.headline}</a></h2>
    <p>{band.sso.text}</p>
    <ul class="band-chips">
      {shown.map((c) => <li><span class="band-chip">{c.mark && <Mark name={c.mark} />}<b>{c.name}</b></span></li>)}
      <li><span class="band-more">and {more} more</span></li>
    </ul>
  </div>

  <div class="band-col band-code">
    <h2><a href={band.code.target}>{band.code.headline}</a></h2>
    <p>{band.code.text}</p>
    <ul class="band-chips">
      {heavy.map((c) => <li><span class="band-chip">{c.mark && <Mark name={c.mark} />}<b>{c.name}</b><span>{c.band}</span></span></li>)}
    </ul>
  </div>

  <div class="band-col band-root">
    <h2><a href={band.root.target}>{band.root.headline}</a></h2>
    <p>{band.root.text}</p>
    <ol class="band-chain">
      {band.root.chain.map((l) => <li><b>{l.name}</b><span>{l.role}</span></li>)}
    </ol>
  </div>
</section>

<div class="mission">
  <p class="mission-text">
    sluis is for the team that keeps a dozen systems&rsquo; access settings aligned by hand. It turns one reviewed file
    into who may reach which system, trades the proofs people and machines already hold for short-lived credentials,
    and records every decision.
  </p>
  <p class="mission-name">A sluis is a canal lock: a vessel passes between two water levels only through a chamber someone controls.</p>
</div>

<div class="cta">
  <a class="btn btn-primary" href="/overview/">Start here</a>
  <a class="btn" href="/runtimes/local/">Read about the local installation</a>
  <a class="btn btn-quiet" href="https://github.com/truvity/sluis">View on GitHub</a>
  <p>v2 is designed, not built; what runs today is sluis v1, documented at <a href="/v1/">/v1/</a>. <a href="#where-it-stands">Where v2 stands</a>.</p>
</div>
