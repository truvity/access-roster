---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { decisionFacts, decisionLayer, listDecisions } from '../../lib-decisions';

// The status, layer and date come from each record's own header lines, so the index
// always says what the record says. The template (0000) is not a record.
const entries = await listDecisions();
const records = entries.map((e) => ({ ...decisionFacts(e), layer: decisionLayer(e) }));
---

<StarlightPage
  frontmatter={{
    title: 'Decisions',
    description:
      'The architecture decision records for sluis: what was decided, why, and which options were set aside. The index is built from docs/decisions.',
    status: 'page',
    badge: false,
  }}
>
  <p>
    Significant choices are recorded as architecture decision records (ADRs) in
    <a href="https://github.com/truvity/sluis/tree/main/docs/decisions"><code>docs/decisions/</code></a>
    in the repository. This index is built from that directory on every build; each status is the one the record states.
    The same facts are in <a href="/data/repo.json"><code>/data/repo.json</code></a>, and the{' '}
    <a href="/status/">project status</a> page places each record under the milestone of its proposal issue.
  </p>
  {
    records.length === 0 ? (
      <p>
        <em>No decision records have been published yet.</em>
      </p>
    ) : (
      <table class="decision-index">
        <thead>
          <tr>
            <th scope="col">Record</th>
            <th scope="col">Decision</th>
            <th scope="col">Status</th>
            <th scope="col">Layer</th>
            <th scope="col">Date</th>
          </tr>
        </thead>
        <tbody>
          {records.map((r) => (
            <tr data-record={r.id}>
              <td>{r.number}</td>
              <td>
                <a href={`/decisions/${r.id}/`}>{r.title}</a>
              </td>
              <td class="decision-status" data-status={r.status}>{r.status}</td>
              <td class="decision-layer" data-layer={r.layer}>{r.layer}</td>
              <td class="decision-date">{r.date ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</StarlightPage>

<style>
  .decision-index td:first-child,
  .decision-status,
  .decision-layer,
  .decision-date {
    white-space: nowrap;
  }
</style>
