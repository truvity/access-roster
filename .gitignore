# Build output
/bin/
/dist/
/out/
*.test
*.out
coverage.*
!site/src/pages/requirements/coverage.astro
*.prof

# Go workspace files are local by choice
go.work
go.work.sum

# Website (Astro Starlight source is site/; only its build output is ignored)
/site/dist/
/site/.astro/
/_site/
# The v1 documentation: the newest v1 release tag is checked out here and built under /v1/.
/v1-src/
.lycheecache
.cache/

# Python tooling for the website
.venv/
__pycache__/
*.pyc

# Node tooling (frontend, TypeScript SDK)
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases/
!.yarn/plugins/
**/.yarn/*
!**/.yarn/releases/
!**/.yarn/plugins/
.pnp.*

# Local environment
.env
.env.*
!.env.example
*.local
.direnv/
.devbox/

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Scratch
/tmp/
*.log

# Cloudflare: the deploy redirect and local state written by the site build
/site/.wrangler/

# Code: Cargo build output, and the state a harness run leaves (keys of a test run)
/target/
/deploy/*/state/
# devbox plugin files that `devbox run` writes
/devbox.d/
