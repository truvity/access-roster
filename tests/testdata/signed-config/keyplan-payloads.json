  {
   "name": "the local KeyPlan source",
   "payload": "# KeyPlan: which keys exist and where they live (keys.yaml). The software key driver ignores the\n# slots; a board's card follows them.\ndefault:\n  cache_ttl: 15m\n  # The wrap recipients: the RFC 7638 thumbprint of each node's wrapping key, and no one else receives a wrap of a\n  # data key (ADR 0006, \"Who may receive a wrap\"). A software key is made at the first start, so the committed list\n  # is empty and the harness fills it in when it signs: deploy/local/local.sh up, deploy/boards/prepare.sh. They\n  # replace the line below, which must stay as it is.\n  recipients: []\n  purposes:\n    - { purpose: wrapping, algorithm: ECDH-P384, slot: 9d }\n    - { purpose: token-signing, algorithm: ES384, slot: 9a }\n    - { purpose: audit-log, algorithm: ES256, slot: \"84\" }\n    - { purpose: data, algorithm: AES-256-GCM }\n",
   "read": {
    "cache_ttl_seconds": 900,
    "recipients": [],
    "purposes": [
     {
      "purpose": "wrapping",
      "algorithm": "ECDH-P384",
      "slot": "9d"
     },
     {
      "purpose": "token-signing",
      "algorithm": "ES384",
      "slot": "9a"
     },
     {
      "purpose": "audit-log",
      "algorithm": "ES256",
      "slot": "84"
     },
     {
      "purpose": "data",
      "algorithm": "AES-256-GCM",
      "slot": ""
     }
    ]
   }
  },
